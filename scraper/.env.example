# BidHubKH Scraper Environment Configuration

# Supabase Connection (Requires Service Role Key to bypass RLS during ingestion)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Intelligence (Optional for extraction)
GEMINI_API_KEY=your-google-gemini-api-key

# Ingestion Settings
LOG_LEVEL=INFO
BATCH_SIZE=25
